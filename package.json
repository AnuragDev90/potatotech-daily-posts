{
  "name": "wordpress-unique-blog-automation",
  "version": "1.0.0",
  "description": "Generate 50 daily unique 1000-word blog posts with featured images and automatically post to WordPress.",
  "main": "daily-automation.js",
  "scripts": {
    "start": "node daily-automation.js",
    "ui": "node server.js",
    "fetch": "node src/fetch-content.js",
    "generate": "node src/generate-unique-posts.js",
    "generate:free": "node src/generate-posts-free.js",
    "post": "node src/post-to-wordpress.js",
    "seo": "node src/seo-optimizer.js",
    "seo-update": "node src/seo-wordpress-updater.js",
    "trends": "node src/fetch-google-trends.js",
    "reddit": "node src/fetch-reddit.js",
    "rank": "node src/rank-with-multiple-sources.js",
    "prompts": "node src/generate-story-prompts.js",
    "orchestrate": "node src/orchestrator.js",
    "orchestrate:groq": "node src/orchestrator-groq.js",
    "orchestrate:openai": "node src/orchestrator-openai.js",
    "cron": "node src/setup-cron.js",
    "generate:groq": "node src/generate-posts-groq.js",
    "test": "node daily-automation.js --test --count=1",
    "test:workflow": "node src/test-full-workflow.js",
    "test:models": "node src/test-groq-models.js",
    "run-tests": "node src/run-tests.js",
    "pipeline": "node src/pipeline.js",
    "topics": "node src/topic-discovery.js",
    "audit": "node src/seo-audit.js"
